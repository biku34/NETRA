# Aggregated environment template. Each service reads its own .env — copy the two files
# below; this file just documents every variable in one place.
#
# ============ backend/.env  (Hotspots API — copy from backend/.env.example) ============
GROQ_API_KEY=              # REQUIRED for the zone assistant + brief chat (console.groq.com)
GROQ_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=         # optional; blank -> deterministic offline narration
GDELT_ENABLED=true         # live news; offline event-calendar fallback keeps working when false
DISTRICT_BBOX=23.14,72.58,23.28,72.72
RANDOM_SEED=42
Z_SPIKE_THRESHOLD=2.0
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:3000
RESEND_API_KEY=            # optional; enables emailing the SHO brief
RESEND_FROM=Netra Crime Intelligence <onboarding@resend.dev>
EMAIL_DEFAULT_TO=          # optional; pre-filled recipient for the Email button
#
# ====== portal/backend/.env  (FIR API — copy from portal/backend/.env.example) ======
NETRA_DEV_USER=123         # development sign-in shown on the login page
NETRA_DEV_PASSWORD=123
NETRA_TEXT_SIMILARITY=tfidf  # auto|embeddings|tfidf (tfidf needs no torch download)
NETRA_JWT_SECRET=          # any random string; blank -> tokens reset on restart
