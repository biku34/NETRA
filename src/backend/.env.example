# Copy to .env and fill in as needed. Ring 0 core runs fully offline with no keys.

# --- Augmentation ---
ANTHROPIC_API_KEY=                        # blank -> Bob uses the offline fallback
GDELT_ENABLED=true                        # GDELT needs no key, only internet (CR-6)

# --- District & model config ---
DISTRICT_BBOX=23.14,72.58,23.28,72.72     # minlat,minlng,maxlat,maxlng (Gandhinagar district)
H3_RES=8
RANDOM_SEED=42
Z_SPIKE_THRESHOLD=2.0

# --- Server ---
# comma-separated; the platform shell (portal) serves the UI on 5173
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:3000

# --- Zone chatbot (Groq) — server-side only, never exposed to the browser ---
GROQ_API_KEY=                             # blank -> zone chat is disabled (503)
GROQ_MODEL=openai/gpt-oss-120b

# Email alerts (Resend) — add your key to enable emailing briefs
RESEND_API_KEY=
RESEND_FROM=Netra Crime Intelligence <onboarding@resend.dev>
# Pre-filled recipient in the "Email this brief" box
EMAIL_DEFAULT_TO=

