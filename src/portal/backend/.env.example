# Copy to backend/.env and fill in. Never commit backend/.env.

# IBM watsonx.ai (Granite). Leave empty to use the local rule engine only.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Signing key for login tokens. Set this so tokens survive a restart.
NETRA_JWT_SECRET=

# Development login
NETRA_DEV_USER=123
NETRA_DEV_PASSWORD=123

# auto | embeddings | tfidf
NETRA_TEXT_SIMILARITY=auto

# SQLite database file. Default is backend/netra.db
# NETRA_DATABASE_PATH=
